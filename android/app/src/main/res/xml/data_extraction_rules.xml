<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) : aucune donnée de l'application n'est copiée par la
     sauvegarde cloud ni par le transfert d'appareil à appareil. Les
     préférences, la base locale, l'index de la corbeille et, plus tard, le
     coffre-fort ne doivent pas quitter l'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
